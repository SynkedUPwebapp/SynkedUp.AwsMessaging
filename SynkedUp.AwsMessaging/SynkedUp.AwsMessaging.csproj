<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <Company>SynkedUP</Company>
        <Description>A library to make it easy to do pub-sub in AWS with SNS and SQS according to SynkedUP conventions.</Description>
        <Copyright>Copyright (c) 2023 SynkedUP</Copyright>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/SynkedUPwebapp/SynkedUp.AwsMessaging</PackageProjectUrl>
        <PackageTags>pubsub;AWS;SNS;SQS;messaging</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../LICENSE" Pack="true" PackagePath="" />
        <None Include="../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="AWSSDK.Extensions.NETCore.Setup" Version="4.0.100.9" />
      <PackageReference Include="AWSSDK.Scheduler" Version="4.0.100.9" />
      <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.9" />
      <PackageReference Include="AWSSDK.SQS" Version="4.0.100.9" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
      <PackageReference Include="System.Text.Json" Version="8.0.6" />
    </ItemGroup>

</Project>
